{
  "name": "@lambadaops/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --poolOptions.threads.maxThreads=1 --poolOptions.threads.minThreads=1",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:isolation": "vitest run -c vitest.isolate.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1097.0",
    "@aws-sdk/s3-request-presigner": "^3.1097.0",
    "@hono/zod-validator": "^0.4.3",
    "@lambadaops/config": "workspace:*",
    "@lambadaops/types": "workspace:*",
    "@neondatabase/serverless": "^0.10.4",
    "@node-rs/argon2": "^2.0.2",
    "drizzle-orm": "^0.44.2",
    "hono": "^4.8.3",
    "jose": "^6.2.4",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.5.1",
    "@vitest/coverage-v8": "2.1.4",
    "drizzle-kit": "^0.30.6",
    "eslint": "^9.28.0",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "*",
    "typescript-eslint": "^8.35.1",
    "vitest": "2.1.4"
  }
}
