{
  "name": "lambadaops",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "cd apps/web && bun dev",
    "dev:api": "cd apps/api && bun dev",
    "build:web": "cd apps/web && bun build",
    "build:api": "cd apps/api && bun build",
    "lint": "cd apps/web && bun lint && cd ../../apps/api && bun lint",
    "test": "cd apps/api && bun test",
    "test:isolation": "cd apps/api && bun test:isolation",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report playwright-report",
    "test:e2e:trace": "playwright show-trace"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/bun": "latest",
    "rimraf": "^6.1.3",
    "typescript": "^5.4.5"
  },
  "module": "index.ts",
  "type": "module",
  "dependencies": {
    "hono-rate-limiter": "0.4.2",
    "playwright": "^1.62.0"
  }
}
