{
  "name": "lambadaops",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "cd apps/web && bun dev",
    "dev:api": "cd apps/api && bun dev",
    "build:web": "cd apps/web && bun build",
    "build:api": "cd apps/api && bun build",
    "lint": "cd apps/web && bun lint && cd ../../apps/api && bun lint",
    "test": "cd apps/api && bun test",
    "test:isolation": "cd apps/api && bun test:isolation"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/bun": "latest",
    "typescript": "^5.4.5"
  },
  "module": "index.ts",
  "type": "module",
  "dependencies": {
    "playwright": "^1.62.0"
  }
}
