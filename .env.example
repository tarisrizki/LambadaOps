# ─── Backend (NestJS — apps/api, deployed to Render) ─────
NODE_ENV=development
PORT=3000

# Neon Postgres
# Development: use the `dev` branch connection string
# Production: use the `main` branch connection string
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DIRECT_DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=lambadaops-dev

# Payment Gateway
# mock = no real payment integration required for MVP
PAYMENT_GATEWAY_DRIVER=mock

# ─── Frontend (Next.js — apps/web, deployed to Vercel) ───
# Public: exposed to browser
NEXT_PUBLIC_API_URL=http://localhost:3000
